apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{.Recipe.Name}}
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{.Recipe.Name}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{.Recipe.Name}}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: {{.Recipe.Name}}
  policyTypes: ["Ingress", "Egress"]
  ingress:
    - ports:
        - protocol: TCP
          port: 8080
  egress:
    - {}
