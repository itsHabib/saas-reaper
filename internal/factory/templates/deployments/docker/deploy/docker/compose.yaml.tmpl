services:
  flags:
    build:
      context: ../..
    environment:
      PORT: "8080"
      REAPER_ADMIN_TOKEN: ${REAPER_ADMIN_TOKEN:?set REAPER_ADMIN_TOKEN}
      REAPER_ADMIN_ACTOR: ${REAPER_ADMIN_ACTOR:-local-operator}
      REAPER_EVALUATION_TOKEN: ${REAPER_EVALUATION_TOKEN:?set REAPER_EVALUATION_TOKEN}
{{if eq .Recipe.Database.Authority "sqlite"}}      DATABASE_PATH: /data/reaper.db
    volumes:
      - reaper-data:/data
{{end}}{{if eq .Recipe.Database.Authority "postgres"}}      DATABASE_URL: postgresql://reaper:reaper@postgres:5432/reaper
    depends_on:
      postgres:
        condition: service_healthy
{{end}}{{if eq .Recipe.Database.Authority "mongodb"}}      DATABASE_URL: mongodb://mongodb:27017/reaper?replicaSet=rs0
    depends_on:
      mongodb:
        condition: service_healthy
{{end}}    ports:
      - "8080:8080"
{{if eq .Recipe.Database.Authority "postgres"}}  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: reaper
      POSTGRES_USER: reaper
      POSTGRES_PASSWORD: reaper
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U reaper"]
      interval: 2s
      timeout: 2s
      retries: 20
    volumes:
      - postgres-data:/var/lib/postgresql/data
{{end}}{{if eq .Recipe.Database.Authority "mongodb"}}  mongodb:
    image: mongo:8.0
    command: ["mongod", "--replSet", "rs0", "--bind_ip_all"]
    healthcheck:
      test: ["CMD-SHELL", "mongosh --quiet --eval \"try { rs.status() } catch (e) { rs.initiate({_id: 'rs0', members: [{_id: 0, host: 'mongodb:27017'}]}) }; db.hello().isWritablePrimary\" | grep -q true"]
      interval: 2s
      timeout: 5s
      retries: 30
    volumes:
      - mongodb-data:/data/db
{{end}}

volumes:
{{if eq .Recipe.Database.Authority "sqlite"}}  reaper-data:
{{end}}{{if eq .Recipe.Database.Authority "postgres"}}  postgres-data:
{{end}}{{if eq .Recipe.Database.Authority "mongodb"}}  mongodb-data:
{{end}}
