data "aws_ami" "linux" {
  most_recent = true
  owners      = ["amazon"]
  filter {
    name   = "name"
    values = ["al2023-ami-2023.*-x86_64"]
  }
}

locals {
  secret_arns = [
    var.admin_token_secret_arn,
    var.evaluation_token_secret_arn,
{{if eq .Recipe.Database.Authority "postgres"}}    var.database_url_secret_arn,
{{end}}  ]
}

resource "aws_iam_role" "instance" {
  name = "{{.Recipe.Name}}-instance"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy" "secrets" {
  role = aws_iam_role.instance.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action   = ["secretsmanager:GetSecretValue"]
      Effect   = "Allow"
      Resource = local.secret_arns
    }]
  })
}

resource "aws_iam_instance_profile" "flags" {
  name = "{{.Recipe.Name}}"
  role = aws_iam_role.instance.name
}

resource "aws_security_group" "flags" {
  name   = "{{.Recipe.Name}}"
  vpc_id = var.vpc_id
  ingress {
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = var.allowed_cidrs
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "flags" {
  ami                    = data.aws_ami.linux.id
  instance_type          = var.instance_type
  subnet_id              = var.subnet_id
  vpc_security_group_ids = [aws_security_group.flags.id]
  iam_instance_profile   = aws_iam_instance_profile.flags.name
  user_data = templatefile("${path.module}/user-data.sh", {
    image                       = var.container_image
    region                      = var.region
    admin_actor_base64          = base64encode(var.admin_actor)
    admin_token_secret_arn      = var.admin_token_secret_arn
    evaluation_token_secret_arn = var.evaluation_token_secret_arn
{{if eq .Recipe.Database.Authority "postgres"}}    database_url_secret_arn      = var.database_url_secret_arn
{{end}}  })
  root_block_device {
    encrypted   = true
    volume_size = 20
  }
}

output "address" {
  value = "http://${aws_instance.flags.public_dns}:8080"
}
