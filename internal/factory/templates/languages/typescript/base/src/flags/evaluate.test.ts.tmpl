import assert from "node:assert/strict";
import test from "node:test";

import { evaluate } from "./evaluate.ts";
import { validateFlag, type Flag } from "./flag.ts";

test("first matching domain rule wins on the flat dotted attribute", () => {
  const flag: Flag = {
    key: "checkout-v2",
    kind: "boolean",
    enabled: true,
    defaultVariant: "off",
    variants: { off: false, on: true },
    rules: [{ attribute: "organization.id", equals: "acme", variant: "on" }],
    revision: 3,
    updatedAt: "2026-01-01T00:00:00Z",
  };
  assert.deepEqual(evaluate(flag, { targetingKey: "user-1", "organization.id": "acme" }), {
    key: "checkout-v2",
    value: true,
    reason: "TARGETING_MATCH",
    variant: "on",
    revision: 3,
  });
});

test("nested context shape does not match the flat wire contract", () => {
  const flag: Flag = {
    key: "checkout-v2",
    kind: "boolean",
    enabled: true,
    defaultVariant: "off",
    variants: { off: false, on: true },
    rules: [{ attribute: "organization.id", equals: "acme", variant: "on" }],
    revision: 3,
    updatedAt: "2026-01-01T00:00:00Z",
  };
  const decision = evaluate(flag, { targetingKey: "user-1", organization: { id: "acme" } });
  assert.equal(decision.value, false);
  assert.equal(decision.reason, "STATIC");
});

test("missing targeting key is rejected", () => {
  const flag: Flag = {
    key: "checkout-v2",
    kind: "boolean",
    enabled: true,
    defaultVariant: "off",
    variants: { off: false },
    rules: [],
    revision: 1,
    updatedAt: "2026-01-01T00:00:00Z",
  };
  assert.throws(() => evaluate(flag, {}), /targetingKey/);
});

test("unknown domain attributes and unsafe keys are rejected", () => {
  const definition = {
    kind: "boolean",
    enabled: true,
    defaultVariant: "off",
    variants: { off: false, on: true },
    rules: [{ attribute: "user.email", equals: "private@example.test", variant: "on" }],
  };
  assert.throws(() => validateFlag(definition, "checkout-v2"), /not approved/);
  assert.throws(() => validateFlag({ ...definition, rules: [] }, "../checkout"), /unsupported character/);
});

test("inherited object properties are not declared variants", () => {
  const definition = {
    kind: "boolean", enabled: true, defaultVariant: "off", variants: { off: false },
  };
  for (const variant of ["constructor", "toString", "__proto__"]) {
    assert.throws(() => validateFlag({ ...definition, defaultVariant: variant }, "checkout"), /not defined/);
    assert.throws(() => validateFlag({ ...definition, rules: [
      { attribute: "targetingKey", equals: "user", variant },
    ] }, "checkout"), /not defined/);
    assert.throws(() => validateFlag({ ...definition, rollout:
      { attribute: "targetingKey", percentage: 100, variant },
    }, "checkout"), /not defined/);
  }
});

test("explicitly declared prototype-named variants survive publication and evaluation", () => {
  const variants: unknown = JSON.parse('{"__proto__":true,"constructor":false}');
  const flag = validateFlag({
    kind: "boolean", enabled: true, defaultVariant: "__proto__", variants,
  }, "checkout");
  assert.equal(evaluate(flag, { targetingKey: "user" }).value, true);
  assert.equal(JSON.stringify(flag.variants), '{"__proto__":true,"constructor":false}');
});
