from __future__ import annotations

import hmac
import json
import re
from dataclasses import asdict, dataclass
from http.server import BaseHTTPRequestHandler
from typing import Any
from urllib.parse import urlparse

from reaper_flags.flags.evaluate import evaluate
from reaper_flags.flags.flag import require_record, to_record, validate_flag
from reaper_flags.store.contract import FlagAuthority, RevisionConflict

MANAGEMENT_PATH = re.compile(r"^/v1/environments/([^/]+)/flags/([^/]+)$")
EVALUATION_PATH = re.compile(r"^/environments/([^/]+)/ofrep/v1/evaluate/flags/([^/]+)$")


@dataclass(frozen=True)
class Configuration:
    admin_token: str
    admin_actor: str
    evaluation_token: str


def make_handler(
    authority: FlagAuthority,
    configuration: Configuration,
) -> type[BaseHTTPRequestHandler]:
    class Handler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            if self.path == "/healthz":
                self.write_json(200, {"status": "ok"})
                return
            self.write_json(404, {"error": "not found"})

        def do_PUT(self) -> None:
            try:
                self.publish()
            except RevisionConflict as error:
                self.write_json(409, {"error": str(error)})
            except (ValueError, json.JSONDecodeError) as error:
                self.write_json(400, {"error": str(error)})

        def do_POST(self) -> None:
            try:
                self.resolve()
            except (ValueError, json.JSONDecodeError) as error:
                self.write_json(400, {"error": str(error)})

        def publish(self) -> None:
            match = MANAGEMENT_PATH.match(urlparse(self.path).path)
            if match is None:
                self.write_json(404, {"error": "not found"})
                return
            if not self.authorized(configuration.admin_token):
                self.write_json(401, {"error": "unauthorized"})
                return
            environment, key = match.groups()
            require_path_segment(environment, "environment")
            require_path_segment(key, "flag key")
            body = require_record(self.read_json(), "request")
            expected_revision = body.get("expectedRevision")
            if not isinstance(expected_revision, int) or isinstance(expected_revision, bool) or expected_revision < 0:
                raise ValueError("expectedRevision must be a non-negative whole number")
            flag = validate_flag(body.get("flag"), key)
            published = authority.publish(
                environment,
                flag,
                expected_revision,
                configuration.admin_actor,
            )
            self.write_json(200, to_record(published))

        def resolve(self) -> None:
            match = EVALUATION_PATH.match(urlparse(self.path).path)
            if match is None:
                self.write_json(404, {"error": "not found"})
                return
            if not self.authorized(configuration.evaluation_token):
                self.write_json(401, {"error": "unauthorized"})
                return
            environment, key = match.groups()
            require_path_segment(environment, "environment")
            require_path_segment(key, "flag key")
            body = require_record(self.read_json(), "request")
            context = require_record(body.get("context"), "context")
            flag = authority.load(environment, key)
            if flag is None:
                self.write_json(404, {"error": "flag not found"})
                return
            decision = evaluate(flag, context)
            response = asdict(decision)
            response["metadata"] = {"revision": response.pop("revision")}
            self.write_json(200, response)

        def authorized(self, expected: str) -> bool:
            header = self.headers.get("Authorization", "")
            if not header.startswith("Bearer "):
                return False
            return hmac.compare_digest(header.removeprefix("Bearer "), expected)

        def read_json(self) -> object:
            length_value = self.headers.get("Content-Length", "0")
            length = int(length_value)
            if length > 1_048_576:
                raise ValueError("request exceeds one megabyte")
            return json.loads(self.rfile.read(length))

        def write_json(self, status: int, body: object) -> None:
            data = json.dumps(body, separators=(",", ":")).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def log_message(self, format: str, *args: Any) -> None:
            return

    return Handler


def require_path_segment(value: str, name: str) -> None:
    if re.fullmatch(r"[A-Za-z0-9._-]+", value) is None:
        raise ValueError(f"{name} contains an unsupported character")
