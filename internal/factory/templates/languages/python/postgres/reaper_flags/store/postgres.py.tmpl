from __future__ import annotations

import json
import os

import psycopg
from psycopg.rows import dict_row

from reaper_flags.flags.audit import AuditEntry
from reaper_flags.flags.flag import Flag, from_record, publish_revision, to_record
from reaper_flags.flags.revision import RevisionConflict


def open_authority() -> PostgresAuthority:
    connection_string = os.environ.get("DATABASE_URL")
    if not connection_string:
        raise ValueError("DATABASE_URL is required")
    return PostgresAuthority(connection_string)


class PostgresAuthority:
    def __init__(self, connection_string: str) -> None:
        self.connection_string = connection_string

    def initialize(self) -> None:
        with psycopg.connect(self.connection_string) as connection:
            connection.execute("""
                CREATE TABLE IF NOT EXISTS flags (
                    environment TEXT NOT NULL,
                    key TEXT NOT NULL,
                    revision BIGINT NOT NULL,
                    definition JSONB NOT NULL,
                    PRIMARY KEY (environment, key)
                );
                CREATE TABLE IF NOT EXISTS audit (
                    sequence BIGSERIAL PRIMARY KEY,
                    environment TEXT NOT NULL,
                    key TEXT NOT NULL,
                    revision BIGINT NOT NULL,
                    actor TEXT NOT NULL,
                    occurred_at TIMESTAMPTZ NOT NULL
                );
            """)

    def load(self, environment: str, key: str) -> Flag | None:
        with psycopg.connect(self.connection_string, row_factory=dict_row) as connection:
            row = connection.execute(
                "SELECT definition FROM flags WHERE environment = %s AND key = %s",
                (environment, key),
            ).fetchone()
            if row is None:
                return None
            return from_record(row["definition"])

    def publish(
        self,
        environment: str,
        flag: Flag,
        expected_revision: int,
        actor: str,
    ) -> Flag:
        try:
            with psycopg.connect(self.connection_string, row_factory=dict_row) as connection:
                row = connection.execute(
                    "SELECT revision FROM flags WHERE environment = %s AND key = %s FOR UPDATE",
                    (environment, flag.key),
                ).fetchone()
                current = None
                if row is not None:
                    current = int(row["revision"])
                require_revision(current, expected_revision)
                published = publish_revision(flag, expected_revision + 1)
                values = (
                    environment,
                    flag.key,
                    published.revision,
                    json.dumps(to_record(published)),
                )
                if row is None:
                    connection.execute(
                        """
                        INSERT INTO flags (environment, key, revision, definition)
                        VALUES (%s, %s, %s, %s)
                    """,
                        values,
                    )
                if row is not None:
                    connection.execute(
                        """
                        UPDATE flags
                        SET revision = %s, definition = %s
                        WHERE environment = %s AND key = %s
                    """,
                        (
                            published.revision,
                            json.dumps(to_record(published)),
                            environment,
                            flag.key,
                        ),
                    )
                connection.execute(
                    """
                    INSERT INTO audit (environment, key, revision, actor, occurred_at)
                    VALUES (%s, %s, %s, %s, %s)
                """,
                    (
                        environment,
                        flag.key,
                        published.revision,
                        actor,
                        published.updated_at,
                    ),
                )
                return published
        except psycopg.errors.UniqueViolation as error:
            raise RevisionConflict(
                f"expected revision {expected_revision}, flag was created concurrently"
            ) from error

    def audit(self, limit: int) -> list[AuditEntry]:
        with psycopg.connect(self.connection_string, row_factory=dict_row) as connection:
            rows = connection.execute(
                "SELECT sequence, environment, key, revision, actor, occurred_at"
                " FROM audit ORDER BY sequence DESC LIMIT %s",
                (limit,),
            ).fetchall()
        return [
            AuditEntry(
                sequence=int(row["sequence"]),
                environment=str(row["environment"]),
                key=str(row["key"]),
                revision=int(row["revision"]),
                actor=str(row["actor"]),
                occurred_at=row["occurred_at"].isoformat(),
            )
            for row in rows
        ]

    def close(self) -> None:
        return


def require_revision(current: int | None, expected: int) -> None:
    if current is None and expected == 0:
        return
    if current == expected:
        return
    actual = 0
    if current is not None:
        actual = current
    raise RevisionConflict(f"expected revision {expected}, current revision {actual}")
