FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/reaper-flags ./cmd/reaper-flags

FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && adduser -D -u 65532 reaper \
    && install -d -o reaper -g reaper /data
COPY --from=build /out/reaper-flags /usr/local/bin/reaper-flags
USER reaper
EXPOSE 8080
CMD ["reaper-flags"]
